    {
      "id": "memory-mcp",
      "name": "Local memory MCP",
      "description": "Local JSONL knowledge-graph memory.",
      "tier": "essential",
      "category": "mcp",
      "capability": "memory",
      "preferred": true,
      "install": {
        "kind": "router"
      },
      "router": {
        "command": "cmd.exe",
        "args": [
          "/c",
          "npx",
          "-y",
          "@modelcontextprotocol/server-memory@2025.11.25"
        ],
        "env": {
          "MEMORY_FILE_PATH": "${AGENTSTACK_DATA}/memory/knowledge-graph.jsonl"
        },
        "warm": {
          "command": "cmd.exe",
          "args": [
            "/c",
            "npx",
            "-y",
            "@modelcontextprotocol/server-memory@2025.11.25",
            "--help"
          ]
        },
        "persistent": true,
        "idleTTLSeconds": 300,
        "limits": {
          "memoryBytes": 2147483648,
          "cpuPercent": 80,
          "activeProcesses": 32
        }
      },
      "dependsOn": [
        "node"
      ],
      "platforms": [
        "windows"
      ]
    },
