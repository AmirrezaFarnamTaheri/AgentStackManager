      "name": "Git",
      "description": "Version control foundation.",
      "tier": "essential",
      "category": "foundation",
      "detectCommands": [
        "git"
      ],
      "install": {
        "kind": "winget",
        "wingetId": "Git.Git",
        "source": "winget",
        "version": "2.50.1",
        "publisher": "Git Development Community"
      },
      "tags": [
        "source-control"
      ],
      "platforms": [
        "windows"
      ],
      "versionPolicy": {
        "minimum": "2.40.0",
        "probe": {
          "command": "git",
          "args": [
            "--version"
          ]
        },
        "pattern": "([0-9]+\\.[0-9]+\\.[0-9]+)"
      }
    },
